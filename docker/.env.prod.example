# PathWorks self-hosted production env file.
# Copy to /etc/pathworks/.env on each LXC, fill in real values, chmod 600.
# The data LXC only needs the [DATA TIER] vars below; the app LXC needs
# everything from [APP TIER] onwards. Most values are shared between both
# files except where noted — easiest to maintain one full file per LXC.

# =============================================================================
# Substitutions used throughout this file
# =============================================================================
# Replace <PATHWORKS_DOMAIN> with your real domain (e.g. pathworks.example.com)
# Replace <DATA_LXC_IP> with the private bridge IP of LXC-A (e.g. 10.0.0.10)

# =============================================================================
# [DATA TIER] — required on LXC-A
# =============================================================================

POSTGRES_DB=pathworks
POSTGRES_USER=pathworks
POSTGRES_PASSWORD=CHANGE_ME_postgres_password

MINIO_ROOT_USER=pathworks
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_root_password

# =============================================================================
# [APP TIER] — required on LXC-B (and most also referenced from migrations)
# =============================================================================

# --- Domain / DNS ---
PATHWORKS_DOMAIN=pathworks.example.com
DATA_LXC_IP=10.0.0.10

# --- TLS ---
# Scoped Cloudflare token: Zone:DNS:Edit on the PathWorks zone only.
CLOUDFLARE_API_TOKEN=CHANGE_ME_cloudflare_dns_token

# --- App URLs ---
PUBLIC_SERVER_URL=https://api.pathworks.example.com
PRIVATE_SERVER_URL=http://api:3081
TRUSTED_ORIGINS=https://pathworks.example.com
DASHBOARD_ORIGIN=https://pathworks.example.com
ORIGIN=https://pathworks.example.com
AUTH_COOKIE_DOMAIN=.pathworks.example.com

# --- Self-hosted flags ---
PUBLIC_IS_SELFHOSTED=true
PRIVATE_APP_HOST=pathworks.example.com
PRIVATE_APP_SUBDOMAINS=app

# --- Postgres connection (from app LXC -> data LXC) ---
DATABASE_URL=postgres://pathworks:CHANGE_ME_postgres_password@10.0.0.10:5432/pathworks
PRIVATE_DATABASE_URL=postgres://pathworks:CHANGE_ME_postgres_password@10.0.0.10:5432/pathworks

# --- Redis ---
REDIS_URL=redis://10.0.0.10:6379

# --- Object storage (server-side talks to MinIO directly on private bridge) ---
OBJECT_STORAGE_ENDPOINT=http://10.0.0.10:9000
OBJECT_STORAGE_PUBLIC_ENDPOINT=https://media.pathworks.example.com
OBJECT_STORAGE_ACCESS_KEY_ID=pathworks
OBJECT_STORAGE_SECRET_ACCESS_KEY=CHANGE_ME_minio_root_password
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_BUCKET_VIDEOS=pathworks-videos
OBJECT_STORAGE_BUCKET_DOCUMENTS=pathworks-documents
OBJECT_STORAGE_BUCKET_MEDIA=pathworks-media
OBJECT_STORAGE_MEDIA_PUBLIC_BASE_URL=https://media.pathworks.example.com

# --- Auth secrets (generate with: openssl rand -base64 48) ---
BETTER_AUTH_SECRET=CHANGE_ME_long_random_secret
PRIVATE_SERVER_KEY=CHANGE_ME_long_random_server_key
AUTH_BEARER_TOKEN=CHANGE_ME_long_random_bearer_token

# --- Email (Postmark, shared neur3.com sender) ---
POSTMARK_API_KEY=CHANGE_ME_postmark_token
POSTMARK_FROM="PathWorks <noreply@neur3.com>"
POSTMARK_MESSAGE_STREAM=outbound

# --- Optional integrations ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
UNSPLASH_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
LICENSE_KEY=
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
PUBLIC_SENTRY_DSN=
PUBLIC_SENTRY_ENVIRONMENT=production

# --- Image tags (override per deploy; defaults to latest) ---
API_IMAGE_TAG=latest
DASHBOARD_IMAGE_TAG=latest
